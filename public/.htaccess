# Empêcher l'accès direct au dossier public
# Rediriger vers la racine sans /public/ dans l'URL

RewriteEngine On

# Si quelqu'un accède à /public directement, rediriger vers la racine
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+projet/ReVente-Auto/public/([^\s]*) [NC]
RewriteRule ^ /projet/ReVente-Auto/%1 [L,R=301]

# ============================================
# COMPRESSION GZIP
# ============================================
<IfModule mod_deflate.c>
    # Activer la compression pour les types de contenu courants
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ============================================
# HEADERS DE CACHE
# ============================================
<IfModule mod_headers.c>
    # Header ETag et Last-Modified
    FileETag MTime Size
    
    # Cache-Control pour les assets statiques
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
    
    # Cache-Control pour HTML (moins longtemps)
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "max-age=0, must-revalidate"
        Header set Last-Modified "now"
    </FilesMatch>
</IfModule>

# ============================================
# SÉCURITÉ ADDITIONNELLE
# ============================================
# Bloquer l'accès aux fichiers sensibles
<FilesMatch "\.(env|git|gitignore|htaccess|htpasswd|ini|log|sh|sql)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>