# Configuration pour le routeur central
Options -MultiViews
DirectoryIndex index.php
RewriteEngine On

# Permettre l'accès aux fichiers statiques (CSS, JS, images)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule . - [L]

# Toutes les autres requêtes passent par le routeur central (index.php)
RewriteRule ^ index.php [L]
