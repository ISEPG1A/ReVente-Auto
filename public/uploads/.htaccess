# Protection des fichiers uploadés
# Empêche l'exécution de scripts PHP dans ce dossier

# 🔒 Désactiver complètement le moteur PHP dans ce dossier
php_flag engine off

# Options restrictives - désactiver l'exécution de scripts et le listing
Options -Indexes -ExecCGI

# Désactiver le parsing PHP
<FilesMatch "\.php$">
    SetHandler none
    SetHandler default-handler
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Interdire l'accès aux fichiers autres que les images
<FilesMatch "(?<!\.jpg|\.jpeg|\.png|\.webp|\.gif)$">
    # Autoriser les images
</FilesMatch>

# Headers de sécurité
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
