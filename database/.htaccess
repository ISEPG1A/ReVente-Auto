# ═══════════════════════════════════════════════════════════════════════════
# SÉCURITÉ : Bloquer tout accès direct au dossier /database
# Les fichiers SQL et schémas ne doivent jamais être accessibles via HTTP
# ═══════════════════════════════════════════════════════════════════════════

# Refuser tout accès
Require all denied

# Alternative pour Apache < 2.4
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
