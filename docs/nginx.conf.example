# ═══════════════════════════════════════════════════════════════════════════
# CONFIGURATION NGINX POUR REVENTE-AUTO
# ═══════════════════════════════════════════════════════════════════════════
# 
# Cette configuration doit être adaptée selon votre hébergeur.
# Contactez votre hébergeur pour appliquer ces modifications.
#
# IMPORTANT pour résoudre :
# 1. L'IP réelle du client (X-Real-IP / X-Forwarded-For)
# 2. Les erreurs 404 pour les fichiers .php inexistants
# ═══════════════════════════════════════════════════════════════════════════

server {
    listen 80;
    listen 443 ssl;
    server_name revente-auto.hangar.garageisep.com;
    
    # Racine du site (dossier public)
    root /var/www/revente-auto/public;
    index index.php;
    
    # ═══════════════════════════════════════════════════════════════════════
    # IMPORTANT : TRANSMETTRE L'IP RÉELLE DU CLIENT
    # ═══════════════════════════════════════════════════════════════════════
    # Ces lignes permettent de transmettre l'IP publique du visiteur
    # au lieu de l'IP du proxy interne (10.10.10.2)
    
    # Si vous êtes derrière un load balancer ou proxy
    set_real_ip_from 10.0.0.0/8;      # Réseau privé classe A
    set_real_ip_from 172.16.0.0/12;   # Réseau privé classe B
    set_real_ip_from 192.168.0.0/16;  # Réseau privé classe C
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    
    # ═══════════════════════════════════════════════════════════════════════
    # ROUTAGE PRINCIPAL - TOUT PASSE PAR index.php
    # ═══════════════════════════════════════════════════════════════════════
    
    location / {
        # Essayer le fichier, puis le dossier, sinon passer à index.php
        try_files $uri $uri/ /index.php?$query_string;
    }
    
    # ═══════════════════════════════════════════════════════════════════════
    # TRAITEMENT DES FICHIERS PHP
    # ═══════════════════════════════════════════════════════════════════════
    
    location ~ \.php$ {
        # IMPORTANT : Si le fichier .php n'existe pas, passer à index.php
        # Cela permet d'afficher la page 404 personnalisée au lieu du 404 nginx
        try_files $uri /index.php?$query_string;
        
        # Configuration FastCGI standard
        fastcgi_pass unix:/var/run/php/php8.0-fpm.sock;
        # OU si vous utilisez TCP : fastcgi_pass 127.0.0.1:9000;
        
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
        
        # Transmettre les headers IP au PHP
        fastcgi_param HTTP_X_REAL_IP $remote_addr;
        fastcgi_param HTTP_X_FORWARDED_FOR $proxy_add_x_forwarded_for;
        fastcgi_param HTTP_X_FORWARDED_PROTO $scheme;
    }
    
    # ═══════════════════════════════════════════════════════════════════════
    # FICHIERS STATIQUES (cache optimisé)
    # ═══════════════════════════════════════════════════════════════════════
    
    location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }
    
    # ═══════════════════════════════════════════════════════════════════════
    # SÉCURITÉ : Bloquer l'accès aux fichiers sensibles
    # ═══════════════════════════════════════════════════════════════════════
    
    location ~ /\.(env|git|htaccess) {
        deny all;
        return 404;
    }
    
    location ~ \.(sql|log|ini|sh)$ {
        deny all;
        return 404;
    }
    
    # Bloquer l'accès au dossier uploads pour les fichiers PHP
    location ~* /uploads/.*\.php$ {
        deny all;
        return 404;
    }
    
    # ═══════════════════════════════════════════════════════════════════════
    # COMPRESSION GZIP
    # ═══════════════════════════════════════════════════════════════════════
    
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/xml;
}

# ═══════════════════════════════════════════════════════════════════════════
# INSTRUCTIONS POUR L'HÉBERGEUR
# ═══════════════════════════════════════════════════════════════════════════
#
# PROBLÈME 1 : Les IPs dans les logs montrent 10.10.10.2 (IP du proxy interne)
# SOLUTION : Ajouter ces lignes dans la config nginx du serveur frontal :
#
#   proxy_set_header X-Real-IP $remote_addr;
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#   proxy_set_header X-Forwarded-Proto $scheme;
#
# ET activer real_ip_header comme montré ci-dessus.
#
# PROBLÈME 2 : Les fichiers .php inexistants affichent le 404 nginx
# SOLUTION : Utiliser try_files dans le bloc location ~ \.php$ :
#
#   try_files $uri /index.php?$query_string;
#
# Cela redirige les .php inexistants vers le routeur PHP qui affichera
# la page 404 personnalisée.
# ═══════════════════════════════════════════════════════════════════════════
