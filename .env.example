# Configuration de la base de données
# Copiez ce fichier en .env et remplissez avec vos valeurs

# Base de données MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=revente_auto
DB_USER=root
DB_PASS=

# Environnement (development, production)
APP_ENV=development

# Fuseau horaire
TZ=Europe/Paris

# Limites PHP (optionnel, pour production)
# PHP_MEMORY_LIMIT=256M
# PHP_UPLOAD_MAX_FILESIZE=10M
# PHP_POST_MAX_SIZE=10M

# URL de base de l'application (sans slash final)
# APP_URL=https://votre-domaine.com

# Configuration des sessions (production)
# SESSION_SECURE=true
# SESSION_HTTPONLY=true
# SESSION_SAMESITE=Lax

# Email (si vous ajoutez l'envoi d'emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=votre-email@gmail.com
# SMTP_PASS=votre-mot-de-passe
# SMTP_FROM=no-reply@votre-domaine.com
