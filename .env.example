# Configuration de la base de données
# Sur Railway, ces variables sont automatiquement définies via ${{MySQL.XXX}}
# En local (XAMPP), les valeurs par défaut dans config.php sont utilisées

# Base de données MySQL (Railway)
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_NAME=${{MySQL.MYSQLDATABASE}}
DB_USER=${{MySQL.MYSQLUSER}}
DB_PASS=${{MySQL.MYSQLPASSWORD}}

# Environnement (development, production)
APP_ENV=production

# Fuseau horaire
TZ=Europe/Paris

# Limites PHP (optionnel, pour production)
# PHP_MEMORY_LIMIT=256M
# PHP_UPLOAD_MAX_FILESIZE=10M
# PHP_POST_MAX_SIZE=10M

# URL de base de l'application (sans slash final)
# APP_URL=https://votre-domaine.com

# Configuration des sessions (production)
# SESSION_SECURE=true
# SESSION_HTTPONLY=true
# SESSION_SAMESITE=Lax

# Email (si vous ajoutez l'envoi d'emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=votre-email@gmail.com
# SMTP_PASS=votre-mot-de-passe
# SMTP_FROM=no-reply@votre-domaine.com
