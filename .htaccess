RewriteEngine On

# Désactiver le listing des répertoires
Options -Indexes

# ═══════════════════════════════════════════════════════════════════════════
# SÉCURITÉ : Bloquer l'accès direct aux fichiers et dossiers sensibles
# ═══════════════════════════════════════════════════════════════════════════

# Bloquer l'accès aux fichiers sensibles
<FilesMatch "^\.env$|^config\.php$|\.sql$|\.md$|\.log$|\.json$">
    Require all denied
</FilesMatch>

# Bloquer l'accès aux dossiers sensibles (tout sauf public/)
RewriteRule ^app/ - [F,L]
RewriteRule ^views/ - [F,L]
RewriteRule ^database/ - [F,L]
RewriteRule ^docs/ - [F,L]
RewriteRule ^donnees/ - [F,L]
RewriteRule ^\.env$ - [F,L]
RewriteRule ^config\.php$ - [F,L]

# ═══════════════════════════════════════════════════════════════════════════
# ROUTAGE : Rediriger vers public/index.php (masquer /public dans l'URL)
# ═══════════════════════════════════════════════════════════════════════════

# Redirection permanente : enlever /public des URLs si présent
RewriteCond %{REQUEST_URI} ^/test/ReVente-Auto/public/(.*)$
RewriteRule ^public/(.*)$ /test/ReVente-Auto/$1 [R=301,L]

# Servir les fichiers statiques depuis public/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/test/ReVente-Auto/public/$1 -f
RewriteRule ^(.*)$ public/$1 [L]

# Rediriger la racine vers public/index.php
RewriteRule ^$ public/index.php [L]

# Tout le reste → public/index.php (routes de l'application)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.php [QSA,L]
