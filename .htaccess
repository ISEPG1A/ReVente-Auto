# Racine du projet ReVente-Auto pour XAMPP
# Tout passe par public/index.php (front controller unique)
RewriteEngine On

# 1. Servir directement fichiers/dossiers existants à la racine
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Tout le reste (routes) va vers public/index.php
RewriteRule ^ public/index.php [L]
